# LLM provider — any OpenAI-compatible endpoint (chat completions + tool calling).
# Defaults below point at a local Ollama instance (free, private, no key needed):
#   1. Install Ollama: https://ollama.com
#   2. ollama pull qwen2.5:7b
#   3. Leave these three commented out to use the defaults, or override to point
#      at another provider (Groq, OpenRouter, LM Studio, Together.ai...).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
