{
  "name": "studyai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
